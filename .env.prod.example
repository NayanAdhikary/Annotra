# ---------- Database ----------
POSTGRES_USER=annotra
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=annotra
DATABASE_URL=postgresql+asyncpg://annotra:CHANGE_ME_STRONG_PASSWORD@postgres:5432/annotra

# ---------- Redis ----------
REDIS_URL=redis://redis:6379/0

# ---------- Auth ----------
SECRET_KEY=CHANGE_ME_64_CHAR_RANDOM_STRING
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------- Domain ----------
DOMAIN=annotra.example.com
REGISTRY=your-dockerhub-username
TAG=latest

# ---------- Storage backend ----------
# "local" (default) or "s3"
STORAGE_BACKEND=local
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto
S3_PUBLIC_URL=

# ---------- Observability ----------
SENTRY_DSN=
LOG_LEVEL=INFO

# ---------- CORS ----------
# Comma separated. In prod: exactly your domain.
ALLOWED_ORIGINS=https://annotra.example.com
